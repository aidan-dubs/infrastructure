[Container]
ContainerName=openproject
Environment=OPENPROJECT_HOST__NAME=project.${DOMAIN}
Environment=OPENPROJECT_HTTPS=true
Environment=OPENPROJECT_DEFAULT__LANGUAGE=en
Environment=OPENPROJECT_APP__TITLE=Project
Environment=OPENPROJECT_SEED__ADMIN__USER__MAIL="opadmin@${DOMAIN}"
Environment=OPENPROJECT_SEED__ADMIN__USER__PASSWORD__RESET=false
Image=docker.io/openproject/openproject:17
Volume=openproject-pgdata:/var/openproject/pgdata
Volume=openproject-assets:/var/openproject/assets
Secret=openproject-key-base,type=env,target=SECRET_KEY_BASE
Secret=openproject-bootstrap-pass,type=env,target=OPENPROJECT_SEED__ADMIN__USER__PASSWORD
Network=caddy.network

[Service]
Restart=always

[Install]
WantedBy=default.target

[Unit]
Wants=authentik.target
After=authentik.target
Wants=caddy.service
After=caddy.service

Requires=podman-secret-gen@openproject-key-base.service
After=podman-secret-gen@openproject-key-base.service
Requires=podman-secret-gen@openproject-bootstrap-pass.service
After=podman-secret-gen@openproject-bootstrap-pass.service
