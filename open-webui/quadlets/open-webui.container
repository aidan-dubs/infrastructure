[Container]
AutoUpdate=registry
ContainerName=open-webui
Image=ghcr.io/open-webui/open-webui:main
Network=open-webui-stack.network
Network=caddy.network
Pull=missing
Volume=open-webui.volume:/app/backend/data
Environment=OLLAMA_BASE_URL=http://olla:40114/olla/ollama
Environment=WEBUI_URL=https://ai.${DOMAIN}/
Environment=HOST=0.0.0.0
Environment=PORT=8080
Environment=FORWARDED_ALLOW_IPS=10.12.0.0/16
Environment=ENABLE_CALENDAR=False
Environment=ENABLE_CHANNELS=False
Environment=ENABLE_USER_STATUS=False
Environment=ENABLE_SUBAGENTS=True
Environment=SUBAGENTS_BACKGROUND_ENABLED=True
Environment=RAG_EMBEDDING_ENGINE=ollama
Environment=RAG_EMBEDDING_MODEL=nomic-embed-text:latest
Environment=ENABLE_FOLLOW_UP_GENERATION=False
Environment=DEFAULT_PROMPT_SUGGESTIONS=[]
Environment=ENABLE_CODE_EXECUTION=False
Environment=BYPASS_ADMIN_ACCESS_CONTROL=False
Environment=TERMINAL_SERVER_CONNECTIONS='[{"id":"e5050126-7a22-4e5d-af3a-05bdfca2b8d9","url":"http://terminal-container:8000","key":"apikey","name":"Terminal","enabled":true,"auth_type":"bearer","config":{"access_grants":[{"principal_type":"user","principal_id":"*","permission":"read"}]}}]'

Secret=open-webui-secret-key,type=env,target=WEBUI_SECRET_KEY
Secret=open-webui-oauth-client-id,type=env,target=OAUTH_CLIENT_ID
Secret=open-webui-oauth-client-secret,type=env,target=OAUTH_CLIENT_SECRET

Environment=ENABLE_PASSWORD_AUTH=False
Environment=OAUTH_MERGE_ACCOUNTS_BY_EMAIL=False
Environment=ENABLE_OAUTH_ROLE_MANAGEMENT=False
Environment=OAUTH_ROLES_CLAIM=groups
Environment=OAUTH_ALLOWED_ROLES=users,admins
Environment=OAUTH_ADMIN_ROLES=admins

Environment=OPENID_PROVIDER_URL=https://auth.${DOMAIN}/application/o/open-webui/.well-known/openid-configuration
Environment=ENABLE_OAUTH_GROUP_CREATION=True
Environment=ENABLE_OAUTH_GROUP_MANAGEMENT=True
ShmSize=1g
Tmpfs=/tmp:exec,mode=1777,size=1G
Tmpfs=/cache:mode=1777,size=512M

[Unit]
After=caddy.container
After=olla.container

Requires=podman-secret-gen@open-webui-secret-key.service
After=podman-secret-gen@open-webui-secret-key.service

Requires=podman-secret-gen@open-webui-oauth-client-id.service
After=podman-secret-gen@open-webui-oauth-client-id.service
Requires=podman-secret-gen@open-webui-oauth-client-secret.service
After=podman-secret-gen@open-webui-oauth-client-secret.service

[Service]
Restart=always


[Install]
WantedBy=default.target
