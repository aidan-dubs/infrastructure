open-webui:
    sudo podman quadlet install --application open-webui-stack --reload-systemd --replace ./quadlets/

    sudo install -CD ./open-webui.caddy /etc/caddy/caddy.d/
    sudo install -CD -m 755 -o root -g root ./common/tmpfiles.d/* /etc/tmpfiles.d/
    sudo install -CD ./olla-config.yaml /etc/olla/config.yaml
    sudo install -CD -m 755 -o root -g root ./selinux/open-webui.mods /etc/custom-selinux/
    sudo install -CD -m 755 -o root -g root ./authentik/open-webui.yaml /etc/authentik/blueprints/
    sudo install -CD -m 755 -o root -g root ./authentik/open-webui-secret.conf /etc/containers/systemd/authentik/auth-secrets.container.d/
