mod common '../common/justfile'

set lists
set unstable

[private]
q-restart: (common::q-restart "forgejo forgejo-oauth")

install: install-config install-quadlet install-tmpfiles install-caddyfile

[cache(inputs=["./app.ini"])]
[private]
[script]
install-config:
    echo "Installing Forgejo config"
    TMPFILE=$(mktemp --suffix .conf) || exit 1
    trap 'rm -f "$TMPFILE"' EXIT
    envsubst '$DOMAIN' < ./app.ini > $TMPFILE
    sudo install -CD $TMPFILE /etc/forgejo/app.ini
    just q-restart

[cache(inputs=split(`find ./quadlets/ -type f`, "\n"))]
[private]
[script]
install-quadlet:
    just common install-quadlet forgejo
    just q-restart

[cache(inputs=split(`find ./ -type f -name '*.caddy'`, "\n"))]
[private]
[script]
install-caddyfile:
    just common install-caddyfile forgejo

[cache(inputs=split(`find ./tmpfiles.d/ -type f`, "\n"))]
[private]
[script]
install-tmpfiles:
    just common install-tmpfiles forgejo
    just q-restart

[cache(inputs=split(`find ./selinux/ -type f`, "\n"))]
[private]
[script]
install-selinux:
    just common install-selinux forgejo
    just q-restart

[cache(inputs=split(`find ./authentik/ -type f`, "\n"))]
[private]
[script]
install-auth:
    just common install-auth forgejo

restart:
    sudo systemctl restart forgejo-oauth forgejo
