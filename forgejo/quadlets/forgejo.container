[Container]
AutoUpdate=registry
ContainerName=forgejo
Image=codeberg.org/forgejo/forgejo:17-rootless
UserNS=auto
Exec=forgejo web --config /etc/forgejo/app.ini --work-path /var/lib/forgejo
PublishPort=2222:2222
Volume=/etc/forgejo:/etc/forgejo:z,U
Volume=/var/lib/forgejo:/var/lib/forgejo:z,U
Secret=forgejo-secret-key
Secret=forgejo-internal-token
Secret=forgejo-oauth2-jwt-secret
Secret=forgejo-lfs-jwt-secret
Network=caddy.network

[Service]
Restart=always

[Unit]
Requires=forgejo-oauth.service
After=forgejo-oauth.service

Requires=podman-secret-gen@forgejo-secret-key.service
Requires=podman-secret-gen@forgejo-oauth-client-id.service
Requires=podman-secret-gen@forgejo-oauth-client-secret.service
Requires=podman-secret-gen@forgejo-internal-token.service
Requires=podman-secret-gen@forgejo-oauth2-jwt-secret.service
Requires=podman-secret-gen@forgejo-lfs-jwt-secret.service
After=podman-secret-gen@forgejo-secret-key.service
After=podman-secret-gen@forgejo-oauth-client-id.service
After=podman-secret-gen@forgejo-oauth-client-secret.service
After=podman-secret-gen@forgejo-internal-token.service
After=podman-secret-gen@forgejo-oauth2-jwt-secret.service
After=podman-secret-gen@forgejo-lfs-jwt-secret.service

[Install]
WantedBy=default.target
