mod common '../common/justfile'

set lists
set unstable

[private]
q-restart: (common::q-restart "openspeedtest")

install: install-quadlet install-caddyfile

[cache(inputs=split(`find ./quadlets/ -type f`, "\n"))]
[private]
[script]
install-quadlet:
    just common install-quadlet openspeedtest
    just q-restart

[cache(inputs=split(`find ./ -type f -name '*.caddy'`, "\n"))]
[private]
[script]
install-caddyfile:
    just common install-caddyfile openspeedtest
