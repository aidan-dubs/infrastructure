set unstable
set lists

repo_root := `git rev-parse --show-toplevel`

restart-needed := repo_root / ".restart-needed"
caddy-reload := repo_root / ".caddy-reload"
blueprints-reload := repo_root / ".blueprints-reload"
selinux-import := repo_root / ".selinux-import"
tmpfiles-reload := repo_root / ".tmpfiles-reload"

[script]
q-restart *services:
    echo "{{ services }} needs restarting"
    for s in {{ services }}; do
        echo "$s" >> "{{ restart-needed }}"
    done

[script]
q-caddy:
    touch "{{ caddy-reload }}"

[script]
q-selinux:
    touch "{{ selinux-import }}"

[script]
q-tmpfiles:
    touch "{{ tmpfiles-reload }}"

[script]
q-blueprints:
    touch "{{ blueprints-reload }}"

setup: env containers-user common-tmpfiles

[private]
[script]
env:
    echo "Setup Env"
    : "${DOMAIN:?DOMAIN is unset. Add it to a .env file}"

    TMPFILE=$(mktemp --suffix .conf) || exit 1
    trap 'rm -f "$TMPFILE"' EXIT

    envsubst '$DOMAIN' < ./environment > $TMPFILE
    sudo install -CD -m 644 -o root -g root $TMPFILE /etc/environment

    sudo install -CD -m 644 -o root -g root ./systemd/system.conf.d/10-global-env.conf \
        /etc/systemd/system.conf.d/

    sudo install -CD -m 644 -o root -g root ./containers/systemd/container.d/10-global-env.conf \
        /etc/containers/systemd/container.d/

selinux_files := split(`find /etc/custom-selinux -type f 2>/dev/null || true`, "\n")

[cache(inputs=selinux_files)]
[script]
selinux:
    echo "Import Selinux mods"
    for file in /etc/custom-selinux/*.mods; do
        [ -e "$file" ] || continue
        sudo semanage import -f "$file"
    done

pod-user := "containers"
id-range := "1000000:1048576"

[cache]
[private]
[script]
containers-user:
    echo "Create containers subuid/gid range"
    if ! id -u "{{ pod-user }}" &>/dev/null; then
        useradd --create-home --shell /usr/sbin/nologin "{{ pod-user }}"
        echo "created user '{{ pod-user }}'"
    fi

    if grep -qE "^{{ pod-user }}:" "/etc/subgid"; then
        sed "s/{{ pod-user }}:[[:digit:]]*:[[:digit:]]*$/{{ pod-user }}:{{ id-range }}/" /etc/subgid
    else
        echo "{{ pod-user }}:{{ id-range }}" >> /etc/subgid
    fi

    if grep -qE "^{{ pod-user }}:" "/etc/subuid"; then
        sed "s/{{ pod-user }}:[[:digit:]]*:[[:digit:]]*$/{{ pod-user }}:{{ id-range }}/" /etc/subuid
    else
        echo "{{ pod-user }}:{{ id-range }}" >> /etc/subuid
    fi

[no-cd]
[script]
install-quadlet app:
    echo "Installing {{ app }} quadlets"

    sudo podman quadlet install --application "{{ app }}" --reload-systemd --replace ./quadlets/

[no-cd]
[script]
install-caddyfile app: setup
    echo "Installing {{ app }} caddyfiles"

    sudo install -CD -m 755 -o root -g root ./*.caddy /etc/caddy/caddy.d/
    just common q-caddy

[no-cd]
[script]
install-tmpfiles app: setup
    echo "Installing {{ app }} tmpfiles"

    sudo install -CD -m 755 -o root -g root ./tmpfiles.d/* /etc/tmpfiles.d/
    just common q-tmpfiles

[no-cd]
[script]
install-selinux app: setup
    echo "Installing {{ app }} selinux mods"

    sudo install -CD -m 755 -o root -g root ./selinux/*.mods /etc/custom-selinux/
    just common q-selinux 

[no-cd]
[script]
install-auth app: setup
    echo "Installing {{ app }} authentik blueprints"

    sudo install -CD -m 755 -o root -g root ./authentik/*.yaml /etc/authentik/blueprints/
    sudo install -CD -m 755 -o root -g root ./authentik/*.conf /etc/containers/systemd/authentik/auth-secrets.container.d/
    just common q-blueprints

[private]
[script]
common-tmpfiles:
    echo "Install common tmpfiles"
    sudo install -CD -m 755 -o root -g root ./tmpfiles.d/* /etc/tmpfiles.d/
    sudo systemd-tmpfiles --create --prefix=/var --prefix=/etc 2>/dev/null

post: tmpfiles selinux restart reload-caddy blueprints

[script]
restart:
    sudo systemctl daemon-reload
    f="{{ restart-needed }}"
    [ -f "$f" ] || exit 0
    sort -u "$f" | xargs -d '\n' -r echo Restarting
    sort -u "$f" | xargs -d '\n' -r sudo systemctl restart
    rm -f "$f"

[script]
reload-caddy:
    f="{{ caddy-reload }}"
    [ -f "$f" ] || exit 0
    echo "Reloading caddy"
    sudo systemctl reload caddy
    rm -rf "$f"

[script]
tmpfiles:
    f="{{ tmpfiles-reload }}"
    [ -f "$f" ] || exit 0
    echo "Creating tmpfiles"
    sudo systemd-tmpfiles --create --prefix=/var --prefix=/etc
    rm -rf "$f"

[script]
blueprints:
    f="{{ blueprints-reload }}"
    [ -f "$f" ] || exit 0
    echo "Reloading blueprints"
    sudo systemctl daemon-reload
    sudo systemctl restart auth-secrets
    sudo systemctl reload auth-worker
    rm -rf "$f"
