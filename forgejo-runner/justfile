mod common '../common/justfile'

set lists
set unstable

[private]
q-restart: (common::q-restart "forgejo-runner-pod")

install: install-quadlet install-override install-tmpfiles install-selinux install-config


[cache(inputs=["./runner-config.yaml"])]
[private]
[script]
install-config:
    echo "Installing Forgejo Runner config"
    sudo install -CD -t /etc/forgejo-runner/ ./runner-config.yaml 
    just q-restart

[cache(inputs=split(`find ./tmpfiles.d/ -type f`, "\n"))]
[private]
[script]
install-tmpfiles:
    just common install-tmpfiles forgejo-runner
    just q-restart

[cache(inputs=split(`find ./selinux/ -type f`, "\n"))]
[private]
[script]
install-selinux:
    just common install-selinux forgejo-runner
    just q-restart


[cache(inputs=split(`find ./quadlets/ -type f`, "\n"))]
[private]
[script]
install-quadlet:
    just common install-quadlet forgejo-runner
    just q-restart

[cache(inputs=split(`find ./podman-secret-gen@forgejo-runner-token.service.d/ -type f `, "\n"))]
[private]
[script]
install-override:
    sudo install -CD -m 644 -o root -g root \
      -t /etc/systemd/system/podman-secret-gen@forgejo-runner-token.service.d/ \
      ./podman-secret-gen@forgejo-runner-token.service.d/*
    just q-restart
    just common::q-restart "forgejo"


[script]
rotate-secret: install-override
    sudo systemctl stop podman-secret-gen@forgejo-runner-token.service forgejo-runner forgejo
    sudo podman secret rm forgejo-runner-token
    just q-restart
    just common::q-restart "forgejo"

[script]
wipe-volume:
    sudo systemctl restart forgejo-runner-pod forgejo-runner.service forgejo-podman.service
    sudo podman volume rm forgejo-runner forgejo-podman forgejo-buildah forgejo-podsock
    just q-restart
