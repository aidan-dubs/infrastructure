[Container]
AutoUpdate=registry
ContainerName=forgejo-podman
Image=quay.io/podman/stable
Exec=podman system service --time=0 unix:///run/podman/podman.sock
SecurityLabelDisable=true
Unmask=All
SeccompProfile=unconfined
AddCapability=All
Volume=forgejo-runner.volume:/data
Volume=forgejo-podsock.volume:/run/podman/
Tmpfs=/tmp:rw,nosuid,nodev,size=64m
Pod=forgejo-runner.pod

[Service]
Restart=always

[Install]
WantedBy=default.target
