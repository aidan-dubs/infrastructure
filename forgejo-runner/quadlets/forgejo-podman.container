[Container]
ContainerName=forgejo-podman
Image=forgejo-podman.build
Exec=podman system service --time=0 unix:///run/podman/podman.sock
AddCapability=All
AddDevice=/dev/loop-control
AddDevice=/dev/mapper/control
AddDevice=/dev/net/tun
Environment=_CONTAINERS_USE_NATIVE_OVERLAY=1
Pod=forgejo-runner.pod
SeccompProfile=unconfined
SecurityLabelDisable=true
Sysctl=net.ipv4.ip_forward=1
Tmpfs=/tmp:rw,nosuid,nodev,size=1024m
Unmask=All
Volume=forgejo-podman.volume:/var/lib/containers
Volume=forgejo-buildah.volume:/var/tmp/buildah-cache
Volume=forgejo-podsock.volume:/run/podman/
PodmanArgs=--privileged

[Service]
Restart=always

[Install]
WantedBy=default.target
