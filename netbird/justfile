set fallback

mod common '../common/justfile'

set lists
set unstable

[private]
q-restart: (common::q-restart netbird-server netbird-dashboard netbird-provisioner netbird-provisioner-build)

install: install-config install-quadlet install-tmpfiles install-caddyfile

[cache(inputs=["./config.yaml"])]
[private]
[script]
install-config:
    TMPFILE=$(mktemp --suffix .conf) || exit 1
    trap 'rm -f "$TMPFILE"' EXIT

    envsubst '$DOMAIN' < ./config.yaml > $TMPFILE
    sudo install -CD -m 755 -o root -g root $TMPFILE /etc/netbird/config.yaml
    just q-restart

[cache(inputs=split(`find ./quadlets/ -type f`, "\n"))]
[private]
[script]
install-quadlet:
    just common install-quadlet netbird
    just q-restart

[cache(inputs=split(`find ./ -type f -name '*.caddy'`, "\n"))]
[private]
@install-caddyfile:
    just common install-caddyfile netbird

[cache(inputs=split(`find ./tmpfiles.d/ -type f`, "\n"))]
[private]
[script]
install-tmpfiles:
    just common install-tmpfiles netbird
    just q-restart

[cache(inputs=split(`find ./authentik/ -type f`, "\n"))]
[private]
[script]
install-auth:
    just common install-auth netbird

# [cache(inputs=split(`find ./selinux/ -type f`, "\n"))]
# [private]
# [script]
# install-selinux: setup
#     just common install-selinux netbird

[confirm("Are you sure you want to reset netbird?")]
reset:
    sudo systemctl stop netbird-server netbird-dashboard netbird-provisioner
    sudo podman volume rm netbird-data netbird-pat
    sudo systemctl start netbird-server netbird-dashboard netbird-provisioner-build netbird-provisioner
