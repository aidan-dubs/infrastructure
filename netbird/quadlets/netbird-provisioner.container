[Container]
Image=netbird-provisioner.build
Secret=netbird-oauth-client-secret
Secret=netbird-oauth-client-id
Secret=netbird-bootstrap-pass
ContainerName=netbird-provision
Network=caddy.network
Network=netbird.network

[Service]
Type=oneshot
RemainAfterExit=yes

[Install]
WantedBy=default.target

[Unit]
Requires=netbird-server.service
After=netbird-server.service

Requires=podman-secret-gen@netbird-oauth-client-id.service
After=podman-secret-gen@netbird-oauth-client-id.service
Requires=podman-secret-gen@netbird-oauth-client-secret.service
After=podman-secret-gen@netbird-oauth-client-secret.service
Requires=podman-secret-gen@netbird-bootstrap-pass.service
After=podman-secret-gen@netbird-bootstrap-pass.service
