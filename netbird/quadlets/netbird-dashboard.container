[Container]
Environment=NETBIRD_MGMT_API_ENDPOINT=https://net.${DOMAIN}
Environment=NETBIRD_MGMT_GRPC_API_ENDPOINT=https://net.${DOMAIN}
Environment=AUTH_AUTHORITY=https://net.${DOMAIN}/oauth2
Environment=AUTH_CLIENT_ID=netbird-dashboard
Environment=AUTH_CLIENT_SECRET=
Environment=AUTH_AUDIENCE=netbird-dashboard
Environment=USE_AUTH0=false
Environment=AUTH_SUPPORTED_SCOPES=openid profile email offline_access
Environment=AUTH_REDIRECT_URI=/nb-auth
Environment=AUTH_SILENT_REDIRECT_URI=/nb-silent-auth
Image=docker.io/netbirdio/dashboard:latest
ContainerName=netbird-dashboard
Network=caddy.network
Network=netbird.network

[Service]
Restart=always

[Install]
WantedBy=default.target

[Unit]
Requires=podman-secret-gen@netbird-oauth-client-id.service
After=podman-secret-gen@netbird-oauth-client-id.service
Requires=podman-secret-gen@netbird-oauth-client-secret.service
After=podman-secret-gen@netbird-oauth-client-secret.service
