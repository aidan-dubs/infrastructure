[Container]
Environment=NETBIRD_MGMT_API_ENDPOINT=https://net.${DOMAIN}:33073
Environment=NETBIRD_MGMT_GRPC_API_ENDPOINT=https://net.${DOMAIN}:33073
Environment=AUTH_AUTHORITY=https://auth.${DOMAIN}/application/o/netbird/
Environment=USE_AUTH0=false
Environment=AUTH_SUPPORTED_SCOPES=openid profile email groups
Environment=AUTH_REDIRECT_URI=/nb-auth
Environment=AUTH_SILENT_REDIRECT_URI=/nb-silent-auth
Image=docker.io/netbirdio/dashboard:latest
Secret=netbird-oauth-client-secret,type=env,target=AUTH_CLIENT_SECRET
Secret=netbird-oauth-client-id,type=env,target=AUTH_CLIENT_ID
Secret=netbird-oauth-client-id,type=env,target=AUTH_AUDIENCE
ContainerName=netbird-dashboard

[Service]
Restart=always

[Install]
WantedBy=default.target

[Unit]
Requires=podman-secret-gen@netbird-oauth-client-id.service
After=podman-secret-gen@netbird-oauth-client-id.service
Requires=podman-secret-gen@netbird-oauth-client-secret.service
After=podman-secret-gen@netbird-oauth-client-secret.service
