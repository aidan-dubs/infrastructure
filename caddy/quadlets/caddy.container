[Container]
AddCapability=NET_ADMIN
AutoUpdate=registry
ContainerName=caddy
UserNS=auto
Image=localhost/caddy:latest
Network=caddy.network:ip=10.12.0.2
PublishPort=0.0.0.0:80:80
PublishPort=0.0.0.0:443:443
Pull=missing
Secret=cloudflare_api_token
Volume=/etc/caddy:/etc/caddy:Z
Volume=caddy_data.volume:/data:U
Volume=caddy_config.volume:/config:U
ReloadCmd=caddy reload --config /etc/caddy/Caddyfile --force

HealthCmd=wget -q --spider http://127.0.0.1:2019/config/
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=300

[Unit]
Requires=podman-secret-exists@cloudflare_api_token.service
After=podman-secret-exists@cloudflare_api_token.service

[Install]
WantedBy=default.target
