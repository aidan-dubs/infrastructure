[Container]
AddCapability=NET_ADMIN
AutoUpdate=registry
ContainerName=caddy
UserNS=auto
Image=caddy.build
Network=host
Pull=missing
Secret=cloudflare_api_token
Volume=/etc/caddy:/etc/caddy:Z
Volume=caddy_data.volume:/data
Volume=caddy_config.volume:/config
ReloadCmd=caddy reload --config /etc/caddy/Caddyfile --force

[Service]
Restart=always
Requires=podman-secret-exists@cloudflare_api_token.service
After=podman-secret-exists@cloudflare_api_token.service

[Install]
WantedBy=default.targe
