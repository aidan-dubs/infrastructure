[Container]
AutoUpdate=registry
ContainerName=homarr
Image=ghcr.io/homarr-labs/homarr:latest
Pull=missing
SecurityLabelDisable=true
Volume=homarr.volume:/appdata

Network=caddy.network

Secret=homarr-encryption-key,type=env,target=SECRET_ENCRYPTION_KEY
Environment=BASE_URL=https://dash.${DOMAIN}
Environment=ENABLE_DOCKER=false
Environment=AUTH_LOGOUT_REDIRECT_URL=https://auth.${DOMAIN}/application/o/homarr/end-session/
Environment=AUTH_OIDC_AUTO_LOGIN=true
Environment=AUTH_OIDC_CLIENT_NAME=Auth
Environment=AUTH_OIDC_GROUPS_ATTRIBUTE=groups
Environment="AUTH_OIDC_SCOPE_OVERWRITE=openid email profile groups"
Environment=AUTH_OIDC_ISSUER=https://auth.${DOMAIN}/application/o/homarr/
Environment=AUTH_OIDC_URI=https://auth.${DOMAIN}/application/o/authorize
Environment=AUTH_PROVIDERS=oidc
Environment=WORKSHOP_API_URL=""
Environment=WORKSHOP_WEB_URL=""
Environment=HOMARR_AI_OPENROUTER_BASE_URL=""
#Environment=AUTH_OIDC_FORCE_USERINFO=true
#Environment=LOG_LEVEL=debug


Secret=homarr-oauth-client-id,type=env,target=AUTH_OIDC_CLIENT_ID
Secret=homarr-oauth-client-secret,type=env,target=AUTH_OIDC_CLIENT_SECRET


[Unit]
After=caddy.service

Requires=podman-secret-gen@homarr-encryption-key.service
After=podman-secret-gen@homarr-encryption-key.service
Requires=podman-secret-gen@homarr-oauth-client-id.service
Requires=podman-secret-gen@homarr-oauth-client-secret.service
After=podman-secret-gen@homarr-oauth-client-id.service
After=podman-secret-gen@homarr-oauth-client-secret.service

[Service]
Restart=always

[Install]
WantedBy=default.target
