mod common '../common/justfile'

set lists
set unstable

[private]
q-restart: (common::q-restart "homarr")

install: install-quadlet install-caddyfile install-override

[cache(inputs=split(`find ./quadlets/ -type f`, "\n"))]
[private]
[script]
install-quadlet:
    just common install-quadlet homarr
    just q-restart

[cache(inputs=split(`find ./ -type f -name '*.caddy'`, "\n"))]
[private]
[script]
install-caddyfile:
    just common install-caddyfile homarr

[cache(inputs=split(`find ./authentik/ -type f`, "\n"))]
[private]
[script]
install-auth:
    just common install-auth homarr

[cache(inputs=split(`find ./podman-secret-gen@homarr-encryption-key.service.d/ -type f `, "\n"))]
[private]
[script]
install-override:
    sudo install -CD -m 644 -o root -g root \
      -t /etc/systemd/system/podman-secret-gen@homarr-encryption-key.service.d/ \
      ./podman-secret-gen@homarr-encryption-key.service.d/*
    just q-restart




[script]
rotate-secret:
    sudo systemctl stop podman-secret-gen@homarr-encryption-key.service homarr
    sudo podman secret rm homarr-encryption-key
