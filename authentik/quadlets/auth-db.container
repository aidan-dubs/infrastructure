[Container]
ContainerName=auth-db
Environment=POSTGRES_DB=authentik
; Environment="POSTGRES_PASSWORD=database password required"
Environment=POSTGRES_USER=authentik
HealthCmd=pg_isready -d $${POSTGRES_DB} -U $${POSTGRES_USER}
HealthInterval=30s
HealthRetries=5
HealthStartPeriod=20s
HealthTimeout=5s
Image=docker.io/library/postgres:16-alpine
Volume=auth-database.volume:/var/lib/postgresql/data
Secret=PG_PASS,type=env,target=POSTGRES_PASSWORD
Network=auth.network
UserNS=auto

[Service]
Restart=always

[Install]
WantedBy=default.target
WantedBy=authentik.target

[Unit]
PartOf=authentik.target
Requires=podman-secret-gen@PG_PASS.service
After=podman-secret-gen@PG_PASS.service
