[Container]
ContainerName=auth-worker
Environment=AUTHENTIK_POSTGRESQL__HOST=auth-db
Environment=AUTHENTIK_POSTGRESQL__NAME=authentik
Environment=AUTHENTIK_POSTGRESQL__USER=authentik
Environment=DOCKER_HOST=tcp://socket-proxy:2375
Exec=worker
Image=ghcr.io/goauthentik/server:2026.8.5
UserNS=auto
ShmSize=512mb
Volume=auth-data.volume:/data
Volume=auth-certs.volume:/certs
Volume=auth-templates.volume:/templates
Secret=PG_PASS,type=env,target=AUTHENTIK_POSTGRESQL__PASSWORD
Secret=AUTHENTIK_SECRET_KEY,type=env,target=AUTHENTIK_SECRET_KEY
Volume=/etc/authentik/blueprints:/blueprints/custom:ro,z
Volume=auth-secrets.volume:/secrets:ro,z
Network=auth.network

HealthCmd=ak healthcheck
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s
Notify=healthy

ReloadCmd=ak shell -c "from authentik.blueprints.models import BlueprintInstance; from authentik.blueprints.v1.tasks import apply_blueprint; [apply_blueprint.send(str(bp.pk)) for bp in BlueprintInstance.objects.filter(enabled=True)]"


[Service]
Restart=always

[Install]
WantedBy=default.target
WantedBy=authentik.target

[Unit]
Wants=auth-secrets.service
After=auth-secrets.service

PartOf=authentik.target
Requires=auth-sockproxy.service auth-db.service
After=auth-sockproxy.service auth-db.service

Requires=podman-secret-gen@PG_PASS.service
After=podman-secret-gen@PG_PASS.service
Requires=podman-secret-gen@AUTHENTIK_SECRET_KEY.service
After=podman-secret-gen@AUTHENTIK_SECRET_KEY.service
