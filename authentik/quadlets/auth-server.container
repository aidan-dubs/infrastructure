[Container]
ContainerName=auth-server
Environment=AUTHENTIK_POSTGRESQL__HOST=auth-db
Environment=AUTHENTIK_POSTGRESQL__NAME=authentik
Environment=AUTHENTIK_POSTGRESQL__USER=authentik
Environment=AUTHENTIK_WEB__BASE_URL=https://auth.${DOMAIN}/
Environment=AUTHENTIK_BOOTSTRAP_EMAIL=admin@${DOMAIN}
Exec=server
Image=ghcr.io/goauthentik/server:2026.8.7
ShmSize=512mb
Pod=authentik.pod
Volume=auth-data.volume:/data:U
Volume=auth-templates.volume:/templates
Secret=PG_PASS,type=env,target=AUTHENTIK_POSTGRESQL__PASSWORD
Secret=AUTHENTIK_SECRET_KEY,type=env,target=AUTHENTIK_SECRET_KEY
Secret=AUTHENTIK_BOOTSTRAP_PASSWORD,type=env,target=AUTHENTIK_BOOTSTRAP_PASSWORD
Network=caddy.network
Network=auth.network
Volume=/etc/authentik/blueprints:/blueprints/custom:Z

HealthCmd=ak healthcheck
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s
Notify=healthy

[Service]
Restart=always

[Install]
WantedBy=default.target
WantedBy=authentik.target

[Unit]
PartOf=authentik.target
Requires=auth-db.service
After=auth-db.service
Requires=podman-secret-gen@AUTHENTIK_BOOTSTRAP_PASSWORD.service
After=podman-secret-gen@AUTHENTIK_BOOTSTRAP_PASSWORD.service
Requires=podman-secret-gen@AUTHENTIK_SECRET_KEY.service
After=podman-secret-gen@AUTHENTIK_SECRET_KEY.service
Requires=podman-secret-gen@PG_PASS.service
After=podman-secret-gen@PG_PASS.service
