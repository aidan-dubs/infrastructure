[Container]
Image=docker.io/library/alpine:latest
ContainerName=auth-secrets
Network=auth.network
UserNS=auto
Volume=auth-secrets.volume:/secrets:z
Exec=/bin/sh -c 'for f in /run/secrets/*; do [ -e "$f" ] && cp -L "$f" /secrets/; done; chmod 0444 /secrets/* 2>/dev/null; touch /secrets/.ready; exec sleep infinity'

[Service]
Restart=always

[Install]
WantedBy=default.target
WantedBy=authentik.target

[Unit]
PartOf=authentik.target
