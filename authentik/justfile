mod common '../common/justfile'

set lists
set unstable

[private]
q-restart: (common::q-restart "authentik.target")

install: install-target install-quadlet install-tmpfiles install-caddyfile

[cache(inputs=["./systemd/system/authentik.target"])]
[private]
[script]
install-target:
    sudo install -CD ./authentik/systemd/system/authentik.target /etc/systemd/system/

[cache(inputs=split(`find ./quadlets/ -type f`, "\n"))]
[private]
[script]
install-quadlet:
    just common install-quadlet authentik
    just q-restart

[cache(inputs=split(`find ./ -type f -name '*.caddy', "\n"`))]
[private]
[script]
install-caddyfile:
    just common install-caddyfile authentik

[cache(inputs=split(`find ./tmpfiles.d/ -type f`, "\n"))]
[private]
[script]
install-tmpfiles:
    just common install-tmpfiles authentik
    just q-restart

[cache(inputs=split(`find ./authentik/ -type f`, "\n"))]
[private]
[script]
install-auth:
    just common install-auth authentik
