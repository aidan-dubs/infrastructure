[Container]
AutoUpdate=registry
ContainerName=example
Image=docker.io/example:latest
UserNS=auto
PublishPort=0.0.0.0:3000:3000
Volume=/etc/example:/etc/example:ro,z
Secret=example-secret

[Service]
Restart=always

[Install]
WantedBy=default.target

[Unit]
Requires=podman-secret-gen@example-secret.service
After=podman-secret-gen@example-secret.service
